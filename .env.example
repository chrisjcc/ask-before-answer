# Hugging Face Access Token for downloading gated models and uploading fine-tuned models
HF_TOKEN=your_huggingface_token_here

# Set your Access Key to your Hugging Face username
AWS_ACCESS_KEY_ID=your_huggingface_key_here

# Set your Secret Key to your Hugging Face Access Key
AWS_SECRET_ACCESS_KEY=your_huggingface_secrete_key_here

# Required to prevent DVC from looking for AWS EC2 metadata on your cluster
AWS_DEFAULT_REGION=us-east-1

# Optional: Weights & Biases for tracking
WANDB_REGISTRY_ENTITY=rl4aa-org
WANDB_ENTITY=rl4aa
WANDB_PROJECT=ask-before-answer
WANDB_API_KEY=your_wandb_api_key_here

# Gemini API Key for evaluation (Gemini 2.5 Flash as a judge)
GEMINI_API_KEY=your_gemini_api_key_here
